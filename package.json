{
  "name": "prontuario-eletronico",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.53.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "lucide-react": "^0.534.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.7.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --level warning",
    "db:verify:p0": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -v ON_ERROR_STOP=1 -f supabase_verify_security_p0.sql",
    "db:migrations:check": "node scripts/check-migration-mirror.mjs",
    "security:secrets": "node scripts/check-tracked-secrets.mjs",
    "db:staging:link": "bash scripts/supabase-link-staging.sh",
    "db:staging:inspect": "bash scripts/supabase-inspect-staging.sh",
    "db:staging:users": "bash scripts/supabase-provision-staging-users.sh",
    "db:staging:reset": "bash scripts/supabase-reset-staging.sh",
    "db:staging:push": "bash scripts/supabase-push-staging.sh",
    "db:production:verify": "bash scripts/supabase-verify-production.sh",
    "db:production:adopt-history": "bash scripts/supabase-adopt-production-history.sh"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js",
      "^react-router$": "<rootDir>/node_modules/react-router/dist/development/index.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "supabase": "2.113.0"
  }
}
