{
  "name": "prontuario-eletronico",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.53.0",
    "lucide-react": "^0.534.0",
    "pdfmake": "^0.3.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.7.1"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "lint": "eslint src",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --level warning",
    "db:test:clinical": "node scripts/test-clinical-writes.mjs",
    "db:verify:p0": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -v ON_ERROR_STOP=1 -f supabase_verify_security_p0.sql",
    "db:migrations:check": "node scripts/check-migration-mirror.mjs",
    "security:secrets": "node scripts/check-tracked-secrets.mjs",
    "db:staging:link": "bash scripts/supabase-link-staging.sh",
    "db:staging:inspect": "bash scripts/supabase-inspect-staging.sh",
    "db:staging:users": "bash scripts/supabase-provision-staging-users.sh",
    "db:staging:reset": "bash scripts/supabase-reset-staging.sh",
    "db:staging:push": "bash scripts/supabase-push-staging.sh",
    "db:production:verify": "bash scripts/supabase-verify-production.sh",
    "db:production:adopt-history": "bash scripts/supabase-adopt-production-history.sh"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "^10.4.21",
    "babel-jest": "30.5.2",
    "eslint": "10.12.0",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "postcss": "^8.5.6",
    "supabase": "2.113.0",
    "vite": "8.3.4"
  }
}
